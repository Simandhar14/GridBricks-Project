# ── Backend ───────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
DATA_DIR=backend/data         # path to Parquet snapshot directory (relative to repo root)
DECISION_CUTOFF_LOCAL=09:00   # HH:MM Europe/London on D-1 (configurable)
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed in development (production: same origin, no CORS needed)
CORS_ORIGINS=http://localhost:5173

